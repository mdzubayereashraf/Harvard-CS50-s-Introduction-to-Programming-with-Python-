def main():
    x = int(input("Enter a number: "))
    if is_even(x):
        print(f"{x} is an even number.")
    else:
        print(f"{x} is an odd number.")

def is_even(num):
    # if num % 2 == 0:
    #     return True
    # else:
    #     return False
    return True if num % 2 == 0 else False

main()